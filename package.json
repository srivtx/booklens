{
  "name": "booklens",
  "version": "0.1.0",
  "description": "Offline EPUB accessibility auditor and auto-fixer. Audit EPUB Accessibility 1.1 / WCAG and write a corrected EPUB in one command.",
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "bin": {
    "booklens": "src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/srivtx/booklens.git"
  },
  "homepage": "https://github.com/srivtx/booklens",
  "bugs": {
    "url": "https://github.com/srivtx/booklens/issues"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "make-fixtures": "bun run scripts/make-fixtures.ts",
    "audit": "bun run src/cli.ts audit",
    "fix": "bun run src/cli.ts fix"
  },
  "keywords": [
    "epub",
    "accessibility",
    "a11y",
    "wcag",
    "epubcheck",
    "daisy",
    "ace",
    "sarif",
    "code-scanning"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.2"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "fflate": "0.8.2",
    "linkedom": "^0.18.13"
  }
}
